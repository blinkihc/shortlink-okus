# Konfigurasi Lingkungan SnipLink (okus.me)
# Salin berkas ini menjadi .env pada lingkungan lokal atau isi di panel Easypanel

# Port Peladen
PORT=8080

# Domain Resmi Aplikasi
VITE_APP_DOMAIN=okus.me

# Kunci Rahasia JWT (Wajib diganti dengan string acak panjang di production)
JWT_SECRET=ganti-dengan-kunci-rahasia-jwt-acak-panjang-pada-production

# Kata Sandi Administrator Awal untuk Akun admin@okus.me (Ganti di production)
ADMIN_PASSWORD=ganti-kata-sandi-admin-aman-production-2026

# Mode Lingkungan ('development' atau 'production')
NODE_ENV=production
